# Secrets. No credential is stored in this repo or the environment, so nothing here should
# ever need to exist. These rules are a safety net against an accidental commit, not
# permission to create one. See the rule in CLAUDE.md and data/raw/README.md.
.env
.env.*

# Python caches and build output
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
.ipynb_checkpoints/

# Editor and OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Raw and processed data are committed on purpose so the pipeline reproduces from a clean
# clone. Nothing under data/ is ignored.
